{
  "name": "places-environment",
  "version": "0.0.2",
  "description": "Environment provider for Places, with NOAA tides, solar events, Open-Meteo weather. Output to charts, tables, templates and maps via VaultQuery providers.",
  "main": "main.js",
  "scripts": {
    "lint": "eslint src package.json manifest.json versions.json",
    "rename": "node -e \"require('fs').rename('main.css', 'styles.css', () => { })\"",
    "generate-help": "md-to-obsidian-dom ./help-md ./src/generated-help --prefix places-environment-help --grammar ./help-grammar.mjs && node -e \"const fs=require('fs'),p=require('path'),walk=d=>fs.readdirSync(d,{withFileTypes:true}).forEach(e=>{const fp=p.join(d,e.name);if(e.isDirectory())walk(fp);else if(e.name.endsWith('.generated.ts')){const c=fs.readFileSync(fp,'utf8');if(!c.startsWith('// @ts-nocheck'))fs.writeFileSync(fp,'// @ts-nocheck\\n'+c)}});walk('./src/generated-help')\"",
    "dev": "npm run dev:core && npm run dev:plugin",
    "build": "npm run typecheck && npm run bundle",
    "typecheck": "tsc --noEmit --pretty false --skipLibCheck",
    "watch": "npm run dev:core && npm run generate-help && node esbuild.config.mjs watch",
    "bundle": "npm run build:core && npm run bundle:plugin",
    "build:core": "tsc -p tsconfig.core.json && node esbuild.core.mjs production",
    "dev:core": "tsc -p tsconfig.core.json && node esbuild.core.mjs",
    "watch:core": "node esbuild.core.mjs watch",
    "prepare": "node --input-type=module -e \"import { hasBuiltExports } from './esbuild.library.mjs'; process.exit(hasBuiltExports() ? 0 : 1)\" || npm run bundle",
    "bundle:plugin": "npm run generate-help && node esbuild.config.mjs production && npm run rename",
    "dev:plugin": "npm run generate-help && node esbuild.config.mjs && npm run rename",
    "format": "node ../../vaultquery-tests/scripts/lint.mjs --format-only --repo . --fix",
    "format:check": "node ../../vaultquery-tests/scripts/lint.mjs --format-only --repo ."
  },
  "keywords": [],
  "author": "Bob Stanton",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^2.1.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "md-to-obsidian-dom": "git+https://github.com/bobstanton/md-to-obsidian-dom.git#ac1da9e441ae5830780706a773863648e8718dfa",
    "obsidian": "1.14.4",
    "tslib": "^2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vaultquery": "git+https://github.com/bobstanton/vaultquery.git#1.2.3"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.4.0",
    "lunarphase-js": "^2.0.3",
    "markdown-table": "^3.1.0",
    "openmeteo": "^1.1.4",
    "places-shared": "git+https://github.com/bobstanton/places-shared.git#0.0.2",
    "user-template-renderer": "git+https://github.com/bobstanton/user-template-renderer.git#f61e96e040845fa5178e6ef67ff0f3bf224047b4",
    "vaultquery": "git+https://github.com/bobstanton/vaultquery.git#1.2.3"
  },
  "overrides": {
    "typescript": "6.0.3",
    "obsidian": "1.14.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15"
  },
  "exports": {
    ".": {
      "require": "./main.js",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./styles.css": "./styles.css",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs",
      "default": "./dist/core/index.js"
    },
    "./core/blocks/WeatherProcessor": {
      "types": "./dist/core/blocks/WeatherProcessor.d.ts",
      "import": "./dist/core/blocks/WeatherProcessor.js",
      "require": "./dist/core/blocks/WeatherProcessor.cjs",
      "default": "./dist/core/blocks/WeatherProcessor.js"
    },
    "./core/blocks/WeatherChartProcessor": {
      "types": "./dist/core/blocks/WeatherChartProcessor.d.ts",
      "import": "./dist/core/blocks/WeatherChartProcessor.js",
      "require": "./dist/core/blocks/WeatherChartProcessor.cjs",
      "default": "./dist/core/blocks/WeatherChartProcessor.js"
    },
    "./core/blocks/WeatherTableProcessor": {
      "types": "./dist/core/blocks/WeatherTableProcessor.d.ts",
      "import": "./dist/core/blocks/WeatherTableProcessor.js",
      "require": "./dist/core/blocks/WeatherTableProcessor.cjs",
      "default": "./dist/core/blocks/WeatherTableProcessor.js"
    },
    "./core/blocks/WeatherTemplateProcessor": {
      "types": "./dist/core/blocks/WeatherTemplateProcessor.d.ts",
      "import": "./dist/core/blocks/WeatherTemplateProcessor.js",
      "require": "./dist/core/blocks/WeatherTemplateProcessor.cjs",
      "default": "./dist/core/blocks/WeatherTemplateProcessor.js"
    },
    "./core/blocks/TideTableProcessor": {
      "types": "./dist/core/blocks/TideTableProcessor.d.ts",
      "import": "./dist/core/blocks/TideTableProcessor.js",
      "require": "./dist/core/blocks/TideTableProcessor.cjs",
      "default": "./dist/core/blocks/TideTableProcessor.js"
    },
    "./core/blocks/TideCardsProcessor": {
      "types": "./dist/core/blocks/TideCardsProcessor.d.ts",
      "import": "./dist/core/blocks/TideCardsProcessor.js",
      "require": "./dist/core/blocks/TideCardsProcessor.cjs",
      "default": "./dist/core/blocks/TideCardsProcessor.js"
    },
    "./core/blocks/TideChartProcessor": {
      "types": "./dist/core/blocks/TideChartProcessor.d.ts",
      "import": "./dist/core/blocks/TideChartProcessor.js",
      "require": "./dist/core/blocks/TideChartProcessor.cjs",
      "default": "./dist/core/blocks/TideChartProcessor.js"
    },
    "./core/blocks/SolarTableProcessor": {
      "types": "./dist/core/blocks/SolarTableProcessor.d.ts",
      "import": "./dist/core/blocks/SolarTableProcessor.js",
      "require": "./dist/core/blocks/SolarTableProcessor.cjs",
      "default": "./dist/core/blocks/SolarTableProcessor.js"
    },
    "./core/blocks/SolarChartProcessor": {
      "types": "./dist/core/blocks/SolarChartProcessor.d.ts",
      "import": "./dist/core/blocks/SolarChartProcessor.js",
      "require": "./dist/core/blocks/SolarChartProcessor.cjs",
      "default": "./dist/core/blocks/SolarChartProcessor.js"
    },
    "./core/blocks/EnvironmentPluginHost": {
      "types": "./dist/core/blocks/EnvironmentPluginHost.d.ts",
      "import": "./dist/core/blocks/EnvironmentPluginHost.js",
      "require": "./dist/core/blocks/EnvironmentPluginHost.cjs",
      "default": "./dist/core/blocks/EnvironmentPluginHost.js"
    },
    "./core/blocks/renderProviderTables": {
      "types": "./dist/core/blocks/renderProviderTables.d.ts",
      "import": "./dist/core/blocks/renderProviderTables.js",
      "require": "./dist/core/blocks/renderProviderTables.cjs",
      "default": "./dist/core/blocks/renderProviderTables.js"
    }
  },
  "files": [
    "dist",
    "src",
    "main.js",
    "styles.css",
    "*.mjs",
    "*.json",
    "globals.d.ts"
  ]
}
